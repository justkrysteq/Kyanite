<UserControl x:Class="Kyanite.Database.Default.Files.FilesInitializationView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">

	<StackPanel Margin="16" Spacing="12">
		<CheckBox x:Name="OverrideCheckbox"
		          Content="Override default path"
		          IsChecked="False"
		          IsCheckedChanged="OverrideDefaultPath" />
		<TextBlock x:Name="OverrideText"
		           VerticalAlignment="Center"
		           IsVisible="False"
		           Text="Not implemented yet" />
	</StackPanel>
</UserControl>
